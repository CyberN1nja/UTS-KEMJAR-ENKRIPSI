# Contoh konfigurasi environment variables untuk implementasi rekomendasi keamanan
# Salin file ini ke .env dan isi dengan nilai yang sesuai

# Kunci enkripsi lokal (32 karakter untuk AES-256)
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

# Konfigurasi database dengan user yang memiliki hak akses terbatas
DB_HOST=localhost
DB_USER=app_user
DB_PASSWORD=strong_password
DB_NAME=uts2keamananjaringanaa

# Konfigurasi AWS KMS untuk integrasi dengan KMS eksternal
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
KMS_KEY_ID=your_kms_key_id

# Konfigurasi Stripe untuk tokenisasi kartu kredit (PCI-DSS)
STRIPE_SECRET_KEY=your_stripe_secret_key

# Port server
PORT=3000